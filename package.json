{
  "name": "youtube-ambientlight-ko",
  "version": "2.38.17.7",
  "description": "This browser extension adds ambient light to the videos you view on YouTube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam-yam/Ambient_Light_for_YT_KR.git"
  },
  "author": "Wessel Kroos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Adam-yam/Ambient_Light_for_YT_KR/issues"
  },
  "homepage": "https://github.com/Adam-yam/Ambient_Light_for_YT_KR#readme",
  "type": "module",
  "scripts": {
    "build:manifest": "node manifest-copy.js",
    "build:html": "copyfiles -u 1 src/options.html dist",
    "build:images": "copyfiles -u 2 src/images/* dist/images",
    "build:styles:content": "sass --no-source-map src/styles/content.scss dist/styles/content.css",
    "build:styles:live-chat": "sass --no-source-map src/styles/live-chat.scss dist/styles/live-chat.css",
    "build:styles:options": "copyfiles -u 2 src/styles/options.css dist/styles",
    "build:styles": "run-p build:styles:content build:styles:live-chat build:styles:options",
    "build:scripts:rollup": "rollup -c",
    "build:scripts": "npm run build:scripts:rollup",
    "build": "run-s build:scripts build:styles build:manifest build:html build:images build:license build:cleanup",
    "build:license": "copyfiles LICENSE dist",
    "build:cleanup": "node cleanup-build.js",
    "test": "eslint src && node tests/release.test.mjs"
  },
  "engines": {
    "node": ">=22.5.1"
  },
  "volta": {
    "node": "22.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "replace-in-file": "^8.3.0",
    "rollup": "^4.42.0",
    "sass": "^1.62.1"
  },
  "overrides": {
    "@rollup/plugin-eslint": {
      "eslint": "$eslint"
    }
  }
}
